{
  "$description": "Reference: the neutral system the open engine is tested against. Colour derived by `af brand --hue 200 --paper #F6F6F4 --saturation 0.2`; positive-light and critical-light are the overlay's positive and critical mixed toward white until they clear 4.6:1 on its espresso, where the base pair sits at 4.5:1; structure, rules and the three OFL voices come from the base file. It exists so the engine can be published without publishing Applied Form's own palette, and it is not a design anyone should ship. The mark's shape parameters are replaced, because Applied Form's identify the brand; its size and placement limits are rules and stay. The two literal steps of the sequential chart scale are the midpoints of its own sand, clay and terra deep.",
  "$extensions": {
    "form.applied": {
      "version": "3.1.0",
      "aspectRatios": [
        "1:1",
        "2:1",
        "2:3",
        "3:2",
        "4:3",
        "16:9"
      ],
      "absent": {
        "$description": "Effects Applied Form deliberately does not use. The absence rules in src/lib/rules/absence.mjs flag any element that reaches for one outside its named exemptions.",
        "$value": [
          "shadow",
          "gradient-fill",
          "radius"
        ]
      },
      "fallbacks": {
        "$description": "When a colour fails a contrast floor on a ground, try these in order.",
        "terracotta": [
          "{color.terra-deep}",
          "{color.terracotta-light}"
        ],
        "teal": [
          "{color.teal-deep}",
          "{color.teal-light}"
        ],
        "clay": [
          "{color.clay-light}",
          "{color.clay-deep}"
        ],
        "caution": [
          "{color.caution-deep}",
          "{color.caution}"
        ],
        "positive": [
          "{color.positive-light}"
        ],
        "critical": [
          "{color.critical-light}"
        ]
      },
      "spreads": {
        "$description": "Register I spread archetypes: the moves. Each is a fixed 16:9 canvas obeying every core floor. data-spread on the section names the move; the linter checks its constraints.",
        "colossus": {
          "ground": "{color.paper}",
          "oncePerDocument": true,
          "voices": [
            "display"
          ],
          "note": "One sentence at the display-01 ceiling."
        },
        "ground-shift": {
          "grounds": 2,
          "joinOnColumn": true,
          "voices": [
            "display",
            "text"
          ],
          "note": "Two colour fields meeting off-centre on a column line, type crossing the join."
        },
        "datum": {
          "ground": "any",
          "figureVoice": "data",
          "voices": [
            "data",
            "text"
          ],
          "note": "A single headline figure set in Plex Mono at display scale."
        },
        "bled-form": {
          "markScale": 3,
          "neverBehindBody": true,
          "voices": [
            "display",
            "text"
          ],
          "note": "The contour mark at ~3x canvas, cropped, as texture. One per spread."
        },
        "index": {
          "ground": "{color.paper}",
          "voices": [
            "display",
            "data"
          ],
          "note": "Contents as a designed page: Fraunces titles, Mono numbers, hairlines."
        },
        "counterpoint": {
          "ground": "{color.espresso}",
          "voices": [
            "display",
            "data"
          ],
          "note": "Display voice against data voice on an espresso ground. Never teal."
        },
        "strata": {
          "ground": "{color.ink}",
          "voices": [
            "display",
            "data"
          ],
          "motion": "scroll",
          "note": "The mark's rings unrolled into horizontal contour bands; values annotate the lines like a map. Experimental."
        },
        "ledger": {
          "ground": "{color.paper}",
          "voices": [
            "data",
            "display"
          ],
          "tabular": true,
          "note": "A whole spread in the data voice: a sheet of evidence with one italic Fraunces word against it. Experimental."
        },
        "palimpsest": {
          "ground": "{color.paper}",
          "voices": [
            "display"
          ],
          "layers": 3,
          "note": "Display type overprinted in three grounds-as-ink, coming into register on scroll. Every layer clears 3:1. Experimental."
        },
        "marginalia": {
          "ground": "{color.paper}",
          "voices": [
            "text",
            "data",
            "display"
          ],
          "sidenotes": true,
          "note": "Narrow measure with the data voice as annotation in the margin. Experimental."
        },
        "counter": {
          "ground": "{color.espresso}",
          "figureVoice": "data",
          "voices": [
            "data",
            "text"
          ],
          "motion": "scroll",
          "note": "A Datum whose figure counts from the low bound of its interval to the estimate as the spread enters view. The interval is the motion. Experimental."
        },
        "hinge": {
          "grounds": 2,
          "joinOnColumn": true,
          "voices": [
            "display",
            "text"
          ],
          "motion": "scroll",
          "note": "A Ground shift whose join steps across column lines with scroll, always landing on one. Experimental."
        },
        "tessera": {
          "ground": "{color.paper}",
          "voices": [
            "display",
            "data"
          ],
          "panels": "1:1",
          "note": "Four square Form panels across the grid, each a different g, with one line of display type beneath. Built from a recipe. Experimental."
        },
        "caesura": {
          "ground": "{color.ink}",
          "voices": [
            "display",
            "data"
          ],
          "note": "A statement on the left eight columns, figures on the right seven, and the ninth column left empty as the pause. Built from a recipe. Experimental."
        },
        "spine": {
          "ground": "{color.espresso}",
          "voices": [
            "data",
            "display"
          ],
          "rotation": -90,
          "note": "A rotated data label runs down the first column; the statement starts at column three; a 3:2 Form panel sits on the right. Built from a recipe. Experimental."
        }
      },
      "mark": {
        "g": 0.25,
        "lobes": 3,
        "rings": 9,
        "gap": 0,
        "asym": 0,
        "core": 3.5,
        "strokeInner": 1,
        "strokeOuter": 0.5,
        "bledOpacity": 0.5,
        "minSizePx": 48,
        "asymMax": 0.08,
        "coreMax": 8.7
      },
      "composition": {
        "offsets": {
          "horizontal": "column",
          "vertical": "spacing",
          "$description": "Absolutely or relatively placed elements sit on column lines horizontally and on the 8px scale vertically."
        },
        "rotation": [
          0,
          90,
          -90
        ],
        "panels": "aspectRatios",
        "bleeds": [
          "half-gutter",
          "column",
          "frame"
        ]
      },
      "recipes": {
        "$description": "Each move as data. cells: grid-column range, layer, voice, role; optional aspect (a permitted ratio), offset {x: columns, y: spacing steps}, bleed (half-gutter | column | frame), rotation (0 | 90 | -90), motion (draw | register | count | step), form {g, lobes, ...}. The linter checks a data-spread section's grid children against its recipe; af move <name> emits the scaffold with the matching composition classes.",
